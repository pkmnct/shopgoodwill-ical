{
    "name": "shopgoodwill-ical",
    "version": "0.2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pkmnct/shopgoodwill-ical.git"
    },
    "author": "George W. Walker",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/pkmnct/shopgoodwill-ical/issues"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "ical-generator": "^11.1.3",
        "shopgoodwill-ts-api": "^1.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-promise": "^7.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2"
    },
    "scripts": {
        "build": "tsc",
        "test": "tsc && node --test \"*.test.js\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "dev": "tsc && node --env-file-if-exists=.env index.js",
        "start": "node index.js",
        "docker:build": "docker build -t shopgoodwill-ical .",
        "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t pkmnct/shopgoodwill-ical:latest --push ."
    },
    "main": "index.js",
    "type": "module"
}
